  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Local companion UI: window movement, visibility and always-on-top only.",
  "windows": ["main"],
  "permissions": ["core:default", "core:window:allow-start-dragging", "core:window:allow-hide", "core:window:allow-center", "core:window:allow-set-position", "core:window:allow-set-always-on-top"]
}
